{
  "name": "focus-me",
  "private": true,
  "packageManager": "pnpm@11.1.3",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "lint": "turbo run lint",
    "test": "turbo run test",

    "dev:web": "turbo run dev --filter=@focus-me/web",
    "dev:extension": "turbo run dev --filter=@focus-me/extension",

    "build:web": "turbo run build --filter=@focus-me/web",
    "build:extension": "turbo run build --filter=@focus-me/extension",

    "db:push": "pnpm --filter @focus-me/db db:push",
    "db:generate": "pnpm --filter @focus-me/db db:generate",
    "db:migrate": "pnpm --filter @focus-me/db db:migrate",
    "db:studio": "pnpm --filter @focus-me/db db:studio"
  },
  "devDependencies": {
    "turbo": "latest"
  }
}
