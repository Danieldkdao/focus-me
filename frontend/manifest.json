{
  "manifest_version": 3,
  "name": "FocusMe",
  "version": "1.0.0",
  "description": "A browser extension to help you focus while still maintaining privacy among users.",
  "action": {
    "default_popup": "index.html",
    "default_title": "Open FocusMe"
  },
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/extension.tsx"]
    }
  ]
}
